{
  "name": "dayshift",
  "version": "1.0.0",
  "private": true,
  "description": "DAYSHIFT — everyday style, your way. Enterprise fashion commerce and retail management platform.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "build:packages": "pnpm --filter @dayshift/config --filter @dayshift/types --filter @dayshift/validation --filter @dayshift/db build",
    "dev:api": "pnpm --filter @dayshift/api dev",
    "dev:web": "pnpm --filter @dayshift/web dev",
    "dev:admin": "pnpm --filter @dayshift/admin dev",
    "dev:worker": "pnpm --filter @dayshift/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @dayshift/e2e test",
    "test:integration": "node scripts/integration-test.mjs",
    "test:exchange": "node scripts/exchange-test.mjs",
    "test:smoke": "node scripts/api-smoke.mjs",
    "test:mobile": "node tests/e2e/mobile-check.mjs",
    "audit:deps": "pnpm audit --audit-level=high",
    "db:generate": "pnpm --filter @dayshift/db generate",
    "db:migrate": "pnpm --filter @dayshift/db migrate:dev",
    "db:deploy": "pnpm --filter @dayshift/db migrate:deploy",
    "db:seed": "pnpm --filter @dayshift/db seed",
    "db:studio": "pnpm --filter @dayshift/db studio",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test:a11y": "pnpm --filter @dayshift/e2e a11y"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "postcss": "8.5.33",
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.22.1"
    }
  }
}
