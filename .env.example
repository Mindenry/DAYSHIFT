# ─────────────────────────────────────────────────────────────
# DAYSHIFT — local development environment
# Copy to .env and adjust for your machine. Never commit .env.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# --- Database -------------------------------------------------
# Docker compose maps PostgreSQL to 5433 to avoid clashing with
# a locally installed PostgreSQL on 5432.
DATABASE_URL="postgresql://dayshift:dayshift@localhost:5433/dayshift?schema=public"
TEST_DATABASE_URL="postgresql://dayshift:dayshift@localhost:5433/dayshift_test?schema=public"

# --- Redis ----------------------------------------------------
REDIS_URL="redis://localhost:6380"

# --- Application URLs ----------------------------------------
APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Secrets (generate with: openssl rand -hex 32) ----------
SESSION_SECRET="dev-only-session-secret-change-in-production-4f8a2c"
PAYMENT_SANDBOX_SECRET="dev-only-sandbox-payment-secret-9b1e7d"

# --- Payments -------------------------------------------------
# sandbox = local simulated card form (no real money moves)
PAYMENT_PROVIDER="sandbox"
PAYMENT_CURRENCY="USD"

# --- Email ----------------------------------------------------
# file = write .eml files to .mail/ (default for local dev)
# smtp = deliver through SMTP (requires credentials)
MAIL_MODE="file"
MAIL_FROM="DAYSHIFT <hello@dayshift.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Shipping -------------------------------------------------
SHIPPING_PROVIDER="sandbox"

# --- Rate limiting -------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
