// DAYSHIFT — commerce & retail management schema
// Money is stored as Decimal(12,2); inventory is tracked per variant per warehouse.
// Financial records (orders, payments, refunds) are never cascade-deleted.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identity ───────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  STORE_MANAGER
  PRODUCT_MANAGER
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
  ORDER_MANAGER
  CUSTOMER_SUPPORT
  MARKETING_MANAGER
  ANALYST
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customerProfile       CustomerProfile?
  staffProfile          StaffProfile?
  addresses             Address[]
  sessions              Session[]
  carts                 Cart[]
  orders                Order[]
  wishlist              Wishlist?
  reviews               Review[]
  reviewVotes           ReviewVote[]
  loyaltyAccount        LoyaltyAccount?
  tickets               SupportTicket[]    @relation("TicketRequester")
  assignedTickets       SupportTicket[]    @relation("TicketAssignee")
  ticketMessages        TicketMessage[]
  notifications         Notification[]
  returnRequests        ReturnRequest[]
  couponUses            CouponRedemption[]
  auditLogs             AuditLog[]
  createdPurchaseOrders PurchaseOrder[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  dateOfBirth    DateTime?
  marketingOptIn Boolean   @default(false)
  staffNotes     String?
  tags           String[]  @default([])
  segment        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([segment])
}

model StaffProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  roleId       String
  employeeCode String   @unique
  jobTitle     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  staff       StaffProfile[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  group       String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  label             String?
  firstName         String
  lastName          String
  line1             String
  line2             String?
  city              String
  state             String?
  postalCode        String
  country           String   @db.VarChar(2)
  phone             String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Catalog ───────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

enum Visibility {
  PUBLIC
  HIDDEN
}

enum CollectionType {
  EDITORIAL
  NEW_ARRIVALS
  BEST_SELLERS
  SALE
  SEASONAL
  LIMITED
}

model Category {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  imageUrl        String?
  parentId        String?
  position        Int      @default(0)
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent        Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]        @relation("CategoryTree")
  products      ProductCategory[]
  sizeGuides    SizeGuide[]
  couponTargets CouponCategory[]
  promotions    Promotion[]

  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Collection {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  imageUrl        String?
  type            CollectionType @default(EDITORIAL)
  position        Int            @default(0)
  isActive        Boolean        @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  products      ProductCollection[]
  promotions    Promotion[]
  couponTargets CouponProductCollection[]
}

model SizeGuide {
  id         String   @id @default(cuid())
  name       String
  categoryId String?
  chart      Json
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([categoryId])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  description      String
  brandId          String?
  status           ProductStatus @default(DRAFT)
  visibility       Visibility    @default(PUBLIC)
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2)
  currency         String        @default("USD") @db.VarChar(3)
  taxClass         String        @default("standard")
  material         String?
  careInstructions String?
  fitNotes         String?
  features         String[]      @default([])
  tags             String[]      @default([])
  sizeGuideId      String?
  weightGrams      Int?
  lengthCm         Decimal?      @db.Decimal(8, 2)
  widthCm          Decimal?      @db.Decimal(8, 2)
  heightCm         Decimal?      @db.Decimal(8, 2)
  isFeatured       Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand         Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sizeGuide     SizeGuide?          @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  categories    ProductCategory[]
  collections   ProductCollection[]
  variants      Variant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  couponTargets CouponProduct[]
  promotions    Promotion[]

  @@index([status, visibility])
  @@index([brandId])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  color     String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model Variant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  size          String?
  color         String?
  colorHex      String?
  priceOverride Decimal? @db.Decimal(12, 2)
  barcode       String?  @unique
  imageUrl      String?
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory          Inventory[]
  movements          InventoryMovement[]
  reservations       StockReservation[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  exchangeItems      ReturnItem[]        @relation("ExchangeVariant")
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
}

// ─────────────────────────── Inventory ───────────────────────────

model Warehouse {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  line1      String
  city       String
  state      String?
  postalCode String
  country    String   @db.VarChar(2)
  phone      String?
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventory      Inventory[]
  movements      InventoryMovement[]
  reservations   StockReservation[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RETURN
  DAMAGE
  RECONCILIATION
}

model Inventory {
  id           String   @id @default(cuid())
  variantId    String
  warehouseId  String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  damaged      Int      @default(0)
  incoming     Int      @default(0)
  safetyStock  Int      @default(0)
  reorderPoint Int      @default(5)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@index([reorderPoint])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  variantId      String
  warehouseId    String
  type           InventoryMovementType
  quantity       Int
  previousOnHand Int
  newOnHand      Int
  reason         String?
  referenceType  String?
  referenceId    String?
  actorId        String?
  createdAt      DateTime              @default(now())

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

model StockReservation {
  id          String            @id @default(cuid())
  variantId   String
  warehouseId String
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  cartId      String?
  orderId     String?
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  releasedAt  DateTime?

  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  cart      Cart?     @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([variantId, status])
  @@index([cartId])
  @@index([orderId])
}

// ─────────────────────────── Cart & Wishlist ───────────────────────────

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  MERGED
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  guestToken String?    @unique
  status     CartStatus @default(ACTIVE)
  currency   String     @default("USD") @db.VarChar(3)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  expiresAt  DateTime?

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        CartItem[]
  reservations StockReservation[]

  @@index([userId, status])
  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  addedAt    DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
  @@index([productId])
}

// ─────────────────────── Promotions & Coupons ───────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionScope {
  ALL
  CATEGORY
  PRODUCT
  COLLECTION
}

model Coupon {
  id                    String       @id @default(cuid())
  code                  String       @unique
  description           String?
  type                  DiscountType
  value                 Decimal      @db.Decimal(12, 2)
  minOrderSubtotal      Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount           Decimal?     @db.Decimal(12, 2)
  startsAt              DateTime
  endsAt                DateTime
  usageLimitTotal       Int?
  usageLimitPerCustomer Int?
  firstOrderOnly        Boolean      @default(false)
  stackable             Boolean      @default(false)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  categories  CouponCategory[]
  products    CouponProduct[]
  collections CouponProductCollection[]
  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponProductCollection {
  couponId     String
  collectionId String

  coupon     Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([couponId, collectionId])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
}

model Promotion {
  id           String         @id @default(cuid())
  name         String
  description  String?
  type         DiscountType
  value        Decimal        @db.Decimal(12, 2)
  scope        PromotionScope @default(ALL)
  categoryId   String?
  productId    String?
  collectionId String?
  minSubtotal  Decimal        @default(0) @db.Decimal(12, 2)
  startsAt     DateTime
  endsAt       DateTime
  priority     Int            @default(0)
  stackable    Boolean        @default(false)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([isActive, startsAt, endsAt])
  @@index([scope])
}

// ─────────────────────────────── Orders ───────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PICKING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
  ON_HOLD
  RETURN_REQUESTED
  PARTIALLY_RETURNED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  SANDBOX_CARD
  CASH_ON_DELIVERY
  STORE_CREDIT
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  guestEmail      String?
  guestToken      String?
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD") @db.VarChar(3)
  couponCode      String?
  customerNote    String?
  internalNotes   String?
  shippingAddress Json
  billingAddress  Json?
  shippingMethod  String?
  idempotencyKey  String?       @unique
  email           String
  phone           String?
  placedAt        DateTime      @default(now())
  paidAt          DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  refunds             Refund[]
  shipments           Shipment[]
  returnRequests      ReturnRequest[]
  couponRedemption    CouponRedemption?
  reservations        StockReservation[]
  loyaltyTransactions LoyaltyTransaction[]
  tickets             SupportTicket[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  variantId         String?
  productId         String?
  productName       String
  productSlug       String
  brandName         String?
  variantSku        String
  size              String?
  color             String?
  imageUrl          String?
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2)
  lineTotal         Decimal @db.Decimal(12, 2)
  discountAllocated Decimal @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal @default(0) @db.Decimal(12, 2)
  refundedQuantity  Int     @default(0)
  returnedQuantity  Int     @default(0)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant     Variant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]
  refundItems RefundItem[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType    @default(SYSTEM)
  actorId    String?
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String
  method        PaymentMethod @default(SANDBOX_CARD)
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD") @db.VarChar(3)
  providerRef   String        @unique
  clientSecret  String?
  failureReason String?
  capturedAt    DateTime?
  failedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

model PaymentEvent {
  id             String    @id @default(cuid())
  paymentId      String?
  provider       String
  eventId        String    @unique
  type           String
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([type])
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  FAILED
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  paymentId       String?
  returnRequestId String?
  amount          Decimal      @db.Decimal(12, 2)
  reason          String
  status          RefundStatus @default(PENDING)
  providerRef     String?
  notes           String?
  processedById   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  items         RefundItem[]

  @@index([orderId])
  @@index([status])
  @@index([returnRequestId])
}

model RefundItem {
  id          String  @id @default(cuid())
  refundId    String
  orderItemId String
  quantity    Int
  amount      Decimal @db.Decimal(12, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
}

// ─────────────────────────── Shipping ───────────────────────────

enum ShipmentStatus {
  READY_TO_SHIP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURN_TO_SENDER
  CANCELLED
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  carrier           String
  service           String
  trackingNumber    String?
  status            ShipmentStatus @default(READY_TO_SHIP)
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// ─────────────────────── Returns & Exchanges ───────────────────────

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURN_SHIPPED
  RECEIVED
  INSPECTED
  REFUND_PENDING
  REFUNDED
  CLOSED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

enum ReturnReason {
  DOES_NOT_FIT
  WRONG_SIZE
  WRONG_COLOR
  NOT_AS_DESCRIBED
  DAMAGED
  DEFECTIVE
  CHANGED_MIND
  OTHER
}

model ReturnRequest {
  id              String           @id @default(cuid())
  returnNumber    String           @unique
  orderId         String
  userId          String?
  status          ReturnStatus     @default(REQUESTED)
  resolution      ReturnResolution @default(REFUND)
  reason          ReturnReason
  customerNote    String?
  adminNote       String?
  refundAmount    Decimal?         @db.Decimal(12, 2)
  exchangeOrderId String?
  requestedAt     DateTime         @default(now())
  approvedAt      DateTime?
  receivedAt      DateTime?
  inspectedAt     DateTime?
  closedAt        DateTime?
  updatedAt       DateTime         @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([userId])
}

model ReturnItem {
  id                String        @id @default(cuid())
  returnRequestId   String
  orderItemId       String
  quantity          Int
  reason            ReturnReason?
  conditionNotes    String?
  imageUrls         String[]      @default([])
  exchangeVariantId String?
  restockApproved   Boolean       @default(false)

  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  exchangeVariant Variant?      @relation("ExchangeVariant", fields: [exchangeVariantId], references: [id], onDelete: SetNull)

  @@index([returnRequestId])
  @@index([orderItemId])
}

// ─────────────────────── Reviews & Content ───────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  helpfulCount       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   ReviewVote[]

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([createdAt])
}

model ReviewVote {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model ContentBlock {
  id        String        @id @default(cuid())
  key       String        @unique
  title     String?
  subtitle  String?
  body      String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  position  Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model NavigationItem {
  id       String  @id @default(cuid())
  label    String
  url      String
  parentId String?
  position Int     @default(0)
  isActive Boolean @default(true)

  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavTree")

  @@index([parentId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── CRM & Support ───────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_INTERNAL_TEAM
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  userId       String?
  orderId      String?
  guestEmail   String?
  subject      String
  description  String
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  resolvedAt   DateTime?

  user       User?           @relation("TicketRequester", fields: [userId], references: [id], onDelete: SetNull)
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([assignedToId])
}

model TicketMessage {
  id          String    @id @default(cuid())
  ticketId    String
  authorType  ActorType
  authorId    String?
  body        String
  isInternal  Boolean   @default(false)
  attachments Json?
  createdAt   DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

// ─────────────────────────── Loyalty ───────────────────────────

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

model LoyaltyAccount {
  id             String      @id @default(cuid())
  userId         String      @unique
  pointsBalance  Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(BRONZE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String        @id @default(cuid())
  accountId String
  type      LoyaltyTxType
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime      @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([orderId])
}

// ─────────────────────── Notifications & Audit ───────────────────────

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  email     String?
  channel   NotificationChannel @default(EMAIL)
  template  String
  subject   String
  body      String
  status    NotificationStatus  @default(PENDING)
  dedupeKey String?             @unique
  error     String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType @default(SYSTEM)
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

// ─────────────────────────── Purchasing ───────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  subtotal    Decimal             @default(0) @db.Decimal(12, 2)
  notes       String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  receivedAt  DateTime?

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantity         Int
  unitCost         Decimal @db.Decimal(12, 2)
  receivedQuantity Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       Variant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, variantId])
  @@index([variantId])
}
